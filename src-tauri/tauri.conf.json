{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapturePro",
  "version": "0.1.0",
  "identifier": "com.admin.tauri-app",
  "build": {
    "beforeDevCommand": "cmd /c .\\\\build-frontend.cmd",
    "beforeBuildCommand": "cmd /c .\\\\build-frontend.cmd",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Capture Pro",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 520
      },
      {
        "label": "overlay",
        "title": "Capture Overlay",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
